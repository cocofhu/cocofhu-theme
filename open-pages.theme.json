{
  "label": "cocofhu",
  "description": "cocofhu 个人站主题：开场文案 / 正在进行 / 最近在做可在设置里编辑（含文案 hover），写作来自博客文章。",
  "settings": [
    {
      "key": "intro_items",
      "label": "开场文案",
      "hint": "固定一条。首句在显示器里；介绍滑入后展开。可用 **加粗**；选中文字可加 hover。",
      "yamlPath": "intro.items",
      "group": "开场文案",
      "type": "list",
      "itemLabel": "开场",
      "minItems": 1,
      "maxItems": 1,
      "itemFields": [
        {
          "key": "lead",
          "label": "首句",
          "type": "annotated-text",
          "tipsKey": "hovers",
          "placeholder": "Hello，大家好，我是 cocofhu。",
          "default": "Hello，大家好，我是 cocofhu。"
        },
        {
          "key": "more",
          "label": "介绍",
          "type": "annotated-text",
          "tipsKey": "hovers",
          "placeholder": "可用 **加粗**；选中文字可加 hover",
          "default": "99年，INTP，**后端研发**。目前负责 **SkillHub** 产品研发，也在探索 **AI Harness**——想做有趣、好用的产品，帮到更多人，也和大家一起进步。"
        }
      ],
      "default": [
        {
          "lead": "Hello，大家好，我是 cocofhu。",
          "more": "99年，INTP，**后端研发**。目前负责 **SkillHub** 产品研发，也在探索 **AI Harness**——想做有趣、好用的产品，帮到更多人，也和大家一起进步。",
          "hovers": [
            { "match": "SkillHub", "tip": "面向中国用户的 AI Skills 社区" },
            { "match": "AI Harness", "tip": "让人和 Agent 更好协作的工作流" }
          ]
        }
      ]
    },
    {
      "key": "intro_tags",
      "label": "开场标签",
      "hint": "首屏下方小标签，空则不显示。",
      "yamlPath": "intro.tags",
      "group": "开场文案",
      "type": "list",
      "itemLabel": "标签",
      "minItems": 0,
      "maxItems": 8,
      "itemFields": [
        { "key": "label", "label": "文案", "type": "text", "placeholder": "SKILLHUB", "default": "" }
      ],
      "default": [
        { "label": "SKILLHUB" },
        { "label": "AI HARNESS" },
        { "label": "BACKEND" },
        { "label": "PRODUCT" }
      ]
    },
    {
      "key": "links_github",
      "label": "GitHub",
      "yamlPath": "links.github",
      "group": "开场链接",
      "type": "text",
      "default": "https://github.com/cocofhu"
    },
    {
      "key": "links_rss",
      "label": "RSS",
      "hint": "订阅地址，站点内路径或完整 URL。Open Pages 默认生成 atom.xml。",
      "yamlPath": "links.rss",
      "group": "开场链接",
      "type": "text",
      "default": "atom.xml"
    },
    {
      "key": "links_email",
      "label": "邮箱",
      "hint": "填邮箱地址即可，空则不显示按钮。",
      "yamlPath": "links.email",
      "group": "开场链接",
      "type": "text",
      "default": ""
    },
    {
      "key": "work_title",
      "label": "区块标题",
      "yamlPath": "work.title",
      "group": "正在进行",
      "type": "text",
      "default": "正在进行"
    },
    {
      "key": "work_items",
      "label": "三段文案",
      "hint": "固定三条，只改文案。插画和 SkillHub 演示不会变。空一行分段；选中文字可加 hover。",
      "yamlPath": "work.items",
      "group": "正在进行",
      "type": "list",
      "itemLabel": "一条在做",
      "minItems": 3,
      "maxItems": 3,
      "itemFields": [
        { "key": "date", "label": "日期 / 标签", "type": "text", "placeholder": "2026 · PRODUCT", "default": "" },
        { "key": "title", "label": "标题", "type": "text", "placeholder": "正在做的事", "default": "" },
        { "key": "url", "label": "链接（可选）", "type": "text", "placeholder": "https://", "default": "" },
        { "key": "link", "label": "按钮文案", "type": "text", "placeholder": "打开", "default": "" },
        {
          "key": "excerpt",
          "label": "文案",
          "type": "annotated-text",
          "tipsKey": "hovers",
          "placeholder": "空一行分段，可用 **加粗**",
          "default": ""
        }
      ],
      "default": [
        {
          "date": "2026 · PRODUCT",
          "title": "SkillHub 研发负责人",
          "url": "https://skillhub.cn/",
          "link": "打开 skillhub.cn",
          "excerpt": "面向中国用户的 **AI Skills 社区**——帮 Agent **搜索、安装、调用** Skill。",
          "hovers": []
        },
        {
          "date": "2026 · AI HARNESS",
          "title": "AI Harness 提效",
          "url": "https://github.com/cocofhu/approving",
          "link": "打开 Approving",
          "excerpt": "深度体验过各种工作流和自动化产品后，对于我来说，最大的问题在于：准确表达需求，以及理解 Agent 输出。\n\n目前主要在探索如何在 **10 秒内**读懂 AI 生成的内容——Demo、流程图等图形化表达；最近也在想用 AI 会议来对齐需求。\n\n开源实践见 Approving。",
          "hovers": [
            { "match": "表达需求", "tip": "对对对就是这样，太对了" },
            { "match": "理解 Agent 输出", "tip": "这么多字我也看不懂啊，给我用，最直白，最直接，最不绕弯子......" },
            { "match": "Demo", "tip": "快速提交 Agent 改动位置" },
            { "match": "流程图", "tip": "快速理解后端流程" },
            { "match": "Approving", "tip": "因为最开始这个工作流完成之后什么也不管，每天就同意审批，所以就取名叫了approving, 嘿嘿，还是要认真确认啊" }
          ]
        },
        {
          "date": "2026 · CREATION",
          "title": "表达与创作",
          "url": "https://github.com/cocofhu",
          "link": "去 GitHub 看看",
          "excerpt": "想去学习一些运营方法，让自己的产品被更多人用起来。\n\n目前计划把我做的小工具在 GitHub 上推广一下，也在社交媒体上做一些输出。",
          "hovers": []
        }
      ]
    },
    {
      "key": "recent_title",
      "label": "区块标题",
      "yamlPath": "recent.title",
      "group": "最近在做",
      "type": "text",
      "default": "最近在做"
    },
    {
      "key": "recent_lede",
      "label": "副文案",
      "yamlPath": "recent.lede",
      "group": "最近在做",
      "type": "text",
      "default": "看看我在做什么"
    },
    {
      "key": "recent_index_label",
      "label": "右上角标签",
      "yamlPath": "recent.index_label",
      "group": "最近在做",
      "type": "text",
      "default": "01 NOTES"
    },
    {
      "key": "recent_items",
      "label": "条目",
      "hint": "在摘要里选中文字，再填写 hover 说明。",
      "yamlPath": "recent.items",
      "group": "最近在做",
      "type": "list",
      "itemLabel": "一条近况",
      "maxItems": 12,
      "itemFields": [
        { "key": "date", "label": "日期", "type": "text", "placeholder": "2026 · 09", "default": "" },
        { "key": "title", "label": "标题", "type": "text", "placeholder": "正在做的事", "default": "" },
        { "key": "tag", "label": "标签", "type": "text", "placeholder": "WELCOME", "default": "NOTE" },
        { "key": "url", "label": "链接（可选）", "type": "text", "placeholder": "https:// 或站内路径", "default": "" },
        {
          "key": "excerpt",
          "label": "文案",
          "type": "annotated-text",
          "tipsKey": "hovers",
          "placeholder": "比项目卡短一点的工程碎片",
          "default": ""
        }
      ],
      "default": [
        {
          "date": "2026 · 09",
          "title": "Hello Open Pages",
          "tag": "WELCOME",
          "url": "",
          "excerpt": "在这里用 Typora 式所见即所得写 Markdown。",
          "hovers": [{ "match": "Typora 式", "tip": "对对对就是这样，太对了" }]
        }
      ]
    },
    {
      "key": "writing_limit",
      "label": "文章篇数",
      "hint": "首页写作列表最多显示几篇，填 0 则不显示",
      "yamlPath": "writing_limit",
      "group": "写作",
      "type": "text",
      "default": "4"
    },
    {
      "key": "about_title",
      "label": "区块标题",
      "yamlPath": "about.title",
      "group": "关于我",
      "type": "text",
      "default": "关于我"
    },
    {
      "key": "about_items",
      "label": "关于我文案",
      "hint": "固定一条。在「文案」里选中文字可加 hover 说明。滑到本区块时右下角会播放形象视频。",
      "yamlPath": "about.items",
      "group": "关于我",
      "type": "list",
      "itemLabel": "一条介绍",
      "minItems": 1,
      "maxItems": 1,
      "itemFields": [
        {
          "key": "lede",
          "label": "导语",
          "type": "text",
          "placeholder": "滑到这里打个招呼",
          "default": "滑到这里打个招呼"
        },
        {
          "key": "body",
          "label": "文案",
          "type": "annotated-text",
          "tipsKey": "hovers",
          "placeholder": "空一行分段，可用 **加粗**；选中文字可加说明",
          "default": "Hello，大家好，我是 **cocofhu**。\n\n99年，INTP，**后端研发**。目前负责 SkillHub 产品研发，也在探索 AI Harness——想做有趣、好用的产品，帮到更多人，也和大家一起进步。"
        }
      ],
      "default": [
        {
          "lede": "滑到这里打个招呼",
          "body": "Hello，大家好，我是 **cocofhu**。\n\n99年，INTP，**后端研发**。目前负责 SkillHub 产品研发，也在探索 AI Harness——想做有趣、好用的产品，帮到更多人，也和大家一起进步。",
          "hovers": []
        }
      ]
    }
  ]
}
