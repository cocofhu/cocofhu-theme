<header class="article-bar">
  <a href="<%= url_for('/') %>">← 返回</a>
</header>
<article class="article">
  <p class="article-meta">
    <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY · MM · DD') %></time>
  </p>
  <h1><%= page.title %></h1>
  <div class="article-body">
    <%- page.content %>
  </div>
</article>
